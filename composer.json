{
    "name": "carloscarrillo/bastion-security-wp",
    "description": "Read-only, defense-in-depth security posture diagnostics for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "BastionSecurityWP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BastionSecurityWP\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
