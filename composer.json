{
    "name": "carloscarrillo/bastion-security-wp",
    "description": "Defense-in-depth security diagnostics and reversible hardening tools for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "BastionSecurityWP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BastionSecurityWP\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "syntax": "@php tools/check-syntax.php",
        "check": [
            "@composer validate --strict",
            "@test",
            "@composer audit",
            "@syntax"
        ],
        "package": "@php tools/build.php",
        "package:verify": "phpunit --filter PackagingTest"
    },
    "config": {
        "sort-packages": true
    }
}
